    <tags>vscode extension vscode-node-azure-pack</tags>
    <dependencies>
      <dependency id="chocolatey-vscode.extension" version="[1.1.0, 2.0.0)" />
      <dependency id="vscode-azureappservice" />
      <dependency id="vscode-azurestaticwebapps" />
      <dependency id="vscode-azurefunctions" />
      <dependency id="vscode-azurestorage" />
      <dependency id="vscode-cosmosdb" />
      <dependency id="vscode-azurevirtualmachines" />
      <dependency id="vscode-azurecontainerapps" />
      <dependency id="vscode-azure-dev" />
      <dependency id="vscode-azure-github-copilot" />
      <dependency id="vscode-azure-mcp-server" />
      <dependency id="vscode-microsoft-testing" />
      <dependency id="vscode-windows-ai-studio" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
    <file src="legal\**" target="legal" />
  </files>
