    <licenseUrl>https://marketplace.visualstudio.com/items/tabnine.tabnine-vscode/license</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description><![CDATA[
Tabnine does not onboard new users to this plugin. If you are interested in our enterprise solution, please contact [email removed]

]]></description>
    <summary>Tabnine does not onboard new users to this plugin. For our enterprise solution please go here: https://marketplace.visualstudio.com/items?itemName=TabNine.tabnine-vscode-self-hosted-updater</summary>
